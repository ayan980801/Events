# Environment Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
DATABASE_URL=postgresql://chatbot_user:chatbot_password@localhost:5432/chatbot_db
MONGODB_URL=mongodb://chatbot_user:chatbot_password@localhost:27017/chatbot_history
REDIS_URL=redis://localhost:6379

# Alternative individual DB settings
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=chatbot_user
DB_PASSWORD=chatbot_password
DB_DATABASE=chatbot_db

# Security Configuration
JWT_SECRET=your-super-secure-jwt-secret-256-bits-long-for-production
JWT_EXPIRES_IN=24h

# AI Provider API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
MISTRAL_API_KEY=your-mistral-api-key

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_PRIVATE_KEY=your-apple-private-key

# Rate Limiting Configuration
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=900000
AUTH_THROTTLE_LIMIT=10

# CORS Configuration (comma-separated for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Email Configuration (for notifications/password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@your-domain.com

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# External Services
SENTRY_DSN=your-sentry-dsn-for-error-tracking
LOG_LEVEL=debug

# WebSocket Configuration
WS_PORT=3001

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL=30000

# Mobile App Configuration
MOBILE_APP_BUNDLE_ID=com.yourcompany.ai-chatbot
MOBILE_APP_VERSION=1.0.0